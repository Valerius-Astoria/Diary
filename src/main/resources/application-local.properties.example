# Copy to application-local.properties (gitignored) for local development.

# H2 in-memory — no external database required
spring.datasource.url=jdbc:h2:mem:diary;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect

# GitHub OAuth — local callback: http://localhost:8080/login/oauth2/code/github
spring.security.oauth2.client.registration.github.client-id=your-github-client-id
spring.security.oauth2.client.registration.github.client-secret=your-github-client-secret
