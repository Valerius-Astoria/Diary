# Copy into Render → Environment (or import as .env). Do not commit real secrets.

# Neon PostgreSQL (Spring Boot maps SPRING_DATASOURCE_* to spring.datasource.*)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-XXXX.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-neon-password

# GitHub OAuth — create app at https://github.com/settings/developers
# Production callback: https://diary.onrender.com/login/oauth2/code/github
# Local callback:       http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
